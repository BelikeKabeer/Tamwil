{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::376424942400:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:BelikeKabeer/Tamwil:*",
            "repo:belikekabeer/tamwil:*",
            "repo:BelikeKabeer/tamwil:*",
            "repo:belikekabeer/Tamwil:*"
          ]
        }
      }
    }
  ]
}
